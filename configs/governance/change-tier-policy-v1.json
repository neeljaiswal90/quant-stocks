    }
  ],
  "forbidden_in_non_t0": {
    "description": "Signatures of the self-verifying / capability-sealed style. Reserved for T0 verifiers; forbidden in new T1 code and all T2/T3 files so pipeline code cannot inherit the receipt ceremony.",
    "python_source_patterns": [
      "EXPECTED_[A-Z0-9_]*SHA256\\s*(?::\\s*Final)?\\s*=",
      "_PREDECESSOR_HASHES\\s*(?::\\s*Final)?\\s*=",
      "RUNTIME_SELF_PIN",
      "_snapshot_global_graph\\s*\\(",
      "_CAPABILITY\\s*=\\s*object\\(\\)",
      "FORGED_[A-Z_]+",
      "def _confined_bytes\\("
    ],
    "path_suffix_patterns": [
      ".hashes.json",
      ".manifest.json",
      "-receipt-v*.json"
    ]
  },
  "checker_self_exclusions": [
    "qme/foundation/change_tiers.py",
    "tests/foundation/test_change_tier_policy.py"
  ],
  "m1_m3_engineering_stream": {
    "definition": "M1 (market-data spine), M2 (identity / corporate actions / coverage), and M3 (signal / ledger / backtest) are ONE T2 engineering stream. Contracts are already frozen (NEE-118/119 T0). Code iterates under PR + CI. The stream produces exactly one governed artifact: a promoted walk-forward run manifest, registered through T0 when it exists.",
    "per_slice_gate": [
      "ruff",
      "strict mypy",
      "pytest",
      "locks",
      "secret scan",
      "protected-main exact-SHA CI"
    ],
    "per_slice_not_required": [
      "hashes manifest",
      "self-pin digest",
      "receipt PR",
      "ledger event",
      "crosswalk version",
      "independent frozen-byte review"
    ],
    "promotion_gate": "First backtest run manifest on pinned data -> T0 registration -> independent review -> receipt.",
    "target": "First walk-forward v0.1 backtest on pinned data within 6-8 weeks of M0 closure."
  },
  "claims": {
    "reduces_existing_t0_ceremony": false,
    "changes_any_frozen_artifact": false,
    "applies_to_new_and_modified_files": true,
    "enforced_in_ci": true
  }
}
