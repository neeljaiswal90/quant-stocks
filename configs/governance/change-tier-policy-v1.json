{
  "$schema": "../../schemas/governance/change-tier-policy-v1.schema.json",
  "schema_version": "qme.change_tier_policy.v1",
  "artifact_id": "QME-CHANGE-TIER-POLICY-V1",
  "status": "ACTIVE_ENFORCED_BY_ARCHITECTURE_TEST",
  "purpose": "Make process weight proportional to what a change governs. Frozen contracts keep the full receipt ceremony; deterministic kernels keep KAT discipline; pipeline engineering (M1-M3) runs on PR + CI only. Enforced mechanically by qme.foundation.change_tiers on every CI run against the tracked tree.",
  "audit_reference": "PROJECT_STATE_AUDIT_2026-08-14 finding F1: governance surface 50.7% of source, pipeline 0%; per-slice receipt ceremony applied to candidate kernels.",
  "classification_rule": "First matching glob wins, evaluated in the order listed under `ordered_rules`. Every tracked file MUST classify; an unclassified path fails CI so new directories are placed deliberately.",
  "tiers": {
    "T0_FROZEN_CONTRACT": {
      "governs": "Owner-mandate values, freeze policy, holdout/access-chain governance, decision math, receipts, and their schemas/fixtures/docs.",
      "required_process": [
        "branch_pr",
        "protected_main_exact_sha_ci",
        "independent_review_recorded",
        "manifest_rebind_on_artifact_change",
        "ledger_event",
        "linear_reconcile"
      ],
      "self_pinning_allowed": true,
      "hashes_manifests_allowed": true,
      "receipt_cadence": "PER_ACCEPTED_CHANGE"
    },
    "T1_ACCEPTED_KERNEL": {
      "governs": "Deterministic numeric kernels whose registered behavior is pinned by known-answer fixtures (stats, fees, equations).",
      "required_process": [
        "branch_pr",
        "protected_main_exact_sha_ci",
        "kat_fixture_change_requires_rationale_in_pr"
      ],
      "self_pinning_allowed": false,
      "self_pinning_grandfathered_paths": [
        "qme/quant/regulatory_fee_schedule.py",
        "qme/quant/regulatory_fees.py",
        "qme/stats/effective_trials.py",
        "qme/stats/effective_trials_uncertainty.py",
        "tests/quant/test_regulatory_fee_schedule.py",
        "tests/quant/test_regulatory_fees.py",
        "tests/stats/test_effective_trials.py",
        "tests/stats/test_effective_trials_uncertainty.py"
      ],
      "hashes_manifests_allowed": false,
      "receipt_cadence": "AT_ACCEPTANCE_MILESTONE_ONLY_NOT_PER_SLICE",
      "hashes_manifests_grandfathered_paths": [
        "tests/fixtures/stats/deterministic-kernel-v1.manifest.json"
      ]
    },
    "T2_ENGINEERING": {
      "governs": "Pipeline and product code: data ingestion, identity, universe, signal, ledger, backtest, execution adapters, UI, CLI, agent-review boundary, foundation utilities, scripts, and non-fixture tests.",
      "required_process": [
        "branch_pr",
        "protected_main_exact_sha_ci"
      ],
      "self_pinning_allowed": false,
      "hashes_manifests_allowed": false,
      "receipt_cadence": "NONE_RESULTS_ARE_GOVERNED_ONLY_AT_PROMOTION",
      "evidence_rule": "A T2 slice never produces a governance artifact. Empirical results become governed only when a run manifest is promoted through a T0 registration; until then they are engineering outputs under QME_DATA_ROOT."
    },
    "T3_DOCUMENTATION": {
      "governs": "Plans, memory, notes, and non-governance documentation.",
      "required_process": [
        "branch_pr",
        "protected_main_exact_sha_ci"
      ],
      "self_pinning_allowed": false,
      "hashes_manifests_allowed": false,
      "receipt_cadence": "NONE"
    }
  },
  "ordered_rules": [
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "qme/quant/contract_v2.py"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "configs/governance/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "configs/quant/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "schemas/**"
    },
    {
