      "glob": "tests/experiments/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "tests/fixtures/governance/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "tests/fixtures/quant/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "tests/fixtures/promotion/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "docs/governance/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": ".github/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "requirements-*.lock"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
