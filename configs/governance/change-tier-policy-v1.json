      "glob": "qme/governance/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "qme/promotion/**"
    },
    {
      "tier": "T0_FROZEN_CONTRACT",
      "glob": "qme/experiments/**"
    },
    {
