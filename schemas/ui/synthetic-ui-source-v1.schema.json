{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qme.local/schemas/ui/synthetic-ui-source-v1.schema.json",
  "$defs": {
    "counts": {
      "additionalProperties": false,
      "properties": {
        "BLOCKED": {"minimum": 0, "type": "integer"},
        "DEGRADED": {"minimum": 0, "type": "integer"},
        "INVALID": {"minimum": 0, "type": "integer"},
        "MISSING": {"minimum": 0, "type": "integer"},
        "STALE": {"minimum": 0, "type": "integer"},
        "VALID": {"minimum": 0, "type": "integer"}
      },
      "required": ["VALID", "DEGRADED", "STALE", "MISSING", "BLOCKED", "INVALID"],
      "type": "object"
    },
    "decimalOrNull": {
      "anyOf": [
        {
          "pattern": "^(?:0|-?(?:[1-9][0-9]*)(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
          "type": "string"
        },
        {"type": "null"}
      ]
    },
    "rankOrNull": {
      "anyOf": [
        {"pattern": "^[1-9][0-9]*$", "type": "string"},
        {"type": "null"}
      ]
    },
    "row": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"data_status": {"enum": ["VALID", "DEGRADED"]}},
            "required": ["data_status"]
          },
          "then": {
            "properties": {
              "momentum_12_1": {
                "pattern": "^(?:0|-?(?:[1-9][0-9]*)(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
                "type": "string"
              },
              "rank": {
                "pattern": "^[1-9][0-9]*$",
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "momentum_12_1": {"type": "null"},
              "rank": {"type": "null"}
            }
          }
        }
      ],
      "properties": {
        "company_name": {"maxLength": 512, "minLength": 1, "type": "string"},
        "data_status": {
          "enum": ["VALID", "DEGRADED", "STALE", "MISSING", "BLOCKED", "INVALID"]
        },
        "momentum_12_1": {"$ref": "#/$defs/decimalOrNull"},
        "rank": {"$ref": "#/$defs/rankOrNull"},
        "review_reasons": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "row_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "security_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^/\\\\\\s]+$",
          "type": "string"
        },
        "selected": {"type": "boolean"},
        "ticker": {"pattern": "^[A-Z0-9][A-Z0-9.-]{0,31}$", "type": "string"}
      },
      "required": [
        "company_name", "data_status", "momentum_12_1", "rank", "review_reasons",
        "row_hash", "security_id", "selected", "ticker"
      ],
      "type": "object"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "analysis_as_of": {"format": "date-time", "type": "string"},
        "artifact_id": {"const": "producer.run_manifest.v1"},
        "completeness_status": {"const": "COMPLETE"},
        "member_status_counts": {"$ref": "#/$defs/counts"},
        "membership_count": {"maximum": 200, "minimum": 1, "type": "integer"},
        "membership_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "membership_snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "run_status": {
          "enum": [
            "CORRUPT", "CONFLICTING", "UNSUPPORTED_SCHEMA", "INVALID", "MISSING",
            "BLOCKED", "STALE", "DEGRADED", "VALID"
          ]
        },
        "schema_version": {"const": "qme.synthetic.ui_source.v1"},
        "security_ids": {
          "items": {"maxLength": 128, "minLength": 1, "type": "string"},
          "maxItems": 200,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "analysis_as_of", "artifact_id", "completeness_status", "member_status_counts",
        "membership_count", "membership_hash", "membership_snapshot_id", "run_id",
        "run_status", "schema_version", "security_ids"
      ],
      "type": "object"
    },
    "universe": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"const": "producer.universe_scores.v1"},
        "membership_count": {"maximum": 200, "minimum": 1, "type": "integer"},
        "membership_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "rows": {
          "items": {"$ref": "#/$defs/row"},
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "schema_version": {"const": "qme.synthetic.ui_source.v1"}
      },
      "required": [
        "artifact_id", "membership_count", "membership_hash", "rows", "run_id",
        "schema_version"
      ],
      "type": "object"
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/run"},
    {"$ref": "#/$defs/universe"}
  ]
}
