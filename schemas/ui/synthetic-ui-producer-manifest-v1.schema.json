{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qme.local/schemas/ui/synthetic-ui-producer-manifest-v1.schema.json",
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"artifact_id": {"const": "producer.run_manifest.v1"}},
            "required": ["artifact_id"]
          },
          "then": {"properties": {"path": {"const": "run.json"}}},
          "else": {"properties": {"path": {"const": "universe-scores.json"}}}
        }
      ],
      "properties": {
        "artifact_id": {
          "enum": ["producer.run_manifest.v1", "producer.universe_scores.v1"]
        },
        "path": {"enum": ["run.json", "universe-scores.json"]},
        "schema_version": {"const": "qme.synthetic.ui_source.v1"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"maximum": 8388608, "minimum": 1, "type": "integer"}
      },
      "required": ["artifact_id", "path", "schema_version", "sha256", "size_bytes"],
      "type": "object"
    },
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "additionalProperties": false,
  "properties": {
    "artifact_index": {
      "allOf": [
        {
          "contains": {
            "properties": {"artifact_id": {"const": "producer.run_manifest.v1"}},
            "required": ["artifact_id"]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {"artifact_id": {"const": "producer.universe_scores.v1"}},
            "required": ["artifact_id"]
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {"$ref": "#/$defs/artifact"},
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "canonicalization_id": {"const": "qme.foundation.canonical_json.v1"},
    "code_revision": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "data_policy_hash": {"$ref": "#/$defs/sha256"},
    "evidence_state": {"const": "SYNTHETIC_FIXTURE"},
    "finalized": {"const": true},
    "finalized_at": {"format": "date-time", "type": "string"},
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "schema_version": {"const": "qme.synthetic.ui_producer_manifest.v1"},
    "strategy_config_hash": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "artifact_index", "canonicalization_id", "code_revision", "data_policy_hash",
    "evidence_state", "finalized", "finalized_at", "run_id", "schema_version",
    "strategy_config_hash"
  ],
  "type": "object"
}
