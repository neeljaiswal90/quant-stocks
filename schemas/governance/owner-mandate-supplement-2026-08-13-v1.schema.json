    "approved_amendments": [
      {
        "amendment_id": "AMENDMENT-1-STANDALONE-TAX-DRAG",
        "text": "Tax drag is standalone: 12 * mean(pre-CGT log return - after-tax log return) > 0.02 is NO_GO; equality is allowed. This deliberately supersedes the prior compound rule 'drag > 2% AND negative after-tax delta'."
      },
      {
        "amendment_id": "AMENDMENT-2-BOUNDARY-ASYMMETRY",
        "text": "Boundary asymmetry is intentional: the primary economic exact boundary is NO_GO; the non-inferiority LCB exact boundary at -0.02 is NO_GO; turnover 4.00 passes and only strict greater-than triggers escalation; tax drag 0.02 passes."
      },
      {
        "amendment_id": "AMENDMENT-3-FREEZE-ACCRUAL-AND-RECEIPT",
        "text": "Prospective accrual begins at the first registered session open strictly after the anchor timestamp. No accrued observation may be consumed by a decision, report, or gate until the receipt verifies. A failed or invalid pair has no prospective status."
      },
      {
        "amendment_id": "AMENDMENT-4-RETURN-COORDINATE-SEPARATION",
        "text": "NEE-121 simple monthly net returns and NEE-120 log returns are intentionally different: simple returns measure cash-reconciliation fidelity, while log returns support log-additive inference."
      }
    ],
