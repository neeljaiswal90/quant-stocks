{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qme.local/schemas/governance/experiment-registry-event-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "event_id",
    "sequence",
    "previous_event_hash",
    "occurred_at",
    "actor_id",
    "event_type",
    "trial_id",
    "payload",
    "event_hash"
  ],
  "properties": {
    "schema_version": {"const": "qme.experiment_registry_event.v1"},
    "registry_id": {"const": "NEE-122-GLOBAL-EXPERIMENT-REGISTRY-V1"},
    "event_id": {"$ref": "#/$defs/text"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_hash": {"$ref": "#/$defs/sha256"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor_id": {"$ref": "#/$defs/text"},
    "event_type": {
      "enum": [
        "POLICY_REGISTERED",
        "TRIAL_REGISTERED",
        "TRIAL_STARTED",
        "SAMPLE_ACCESS_BOUND",
        "OUTCOME_RECORDED",
        "TRIAL_COMPLETED",
        "TRIAL_FAILED",
        "TRIAL_SKIPPED",
        "TRIAL_ABANDONED"
      ]
    },
    "trial_id": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "payload": {"type": "object"},
    "event_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "POLICY_REGISTERED"}}},
      "then": {
        "properties": {
          "trial_id": {"type": "null"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy"],
            "properties": {"policy": {"$ref": "#/$defs/runtimePolicy"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "TRIAL_REGISTERED"}}},
      "then": {
        "properties": {
          "trial_id": {"$ref": "#/$defs/text"},
          "payload": {"$ref": "#/$defs/trialRegistration"}
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "TRIAL_STARTED"}}},
      "then": {
        "properties": {
          "trial_id": {"$ref": "#/$defs/text"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "retry_reason"],
            "properties": {
              "run_id": {"$ref": "#/$defs/text"},
              "retry_reason": {
                "oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "SAMPLE_ACCESS_BOUND"}}},
      "then": {
        "properties": {
          "trial_id": {"$ref": "#/$defs/text"},
          "payload": {"$ref": "#/$defs/sampleAccessBinding"}
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "OUTCOME_RECORDED"}}},
      "then": {
        "properties": {
          "trial_id": {"$ref": "#/$defs/text"},
          "payload": {"$ref": "#/$defs/outcome"}
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "TRIAL_COMPLETED"}}},
      "then": {
        "properties": {
          "trial_id": {"$ref": "#/$defs/text"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {"reason": {"type": "null"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": ["TRIAL_FAILED", "TRIAL_SKIPPED", "TRIAL_ABANDONED"]
          }
        }
      },
      "then": {
        "properties": {
          "trial_id": {"$ref": "#/$defs/text"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {"reason": {"$ref": "#/$defs/text"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "source_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/text"},
        "source_id": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "source_id", "sha256", "role"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/text"},
        "source_id": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {
          "enum": [
            "AGENT_OVERLAY",
            "BENCHMARK",
            "CODE",
            "CONFIG",
            "COST",
            "DATA",
            "FILTER",
            "HOLDING_PERIOD",
            "LOOKBACK",
            "REBALANCE",
            "SCHEMA",
            "SIGNAL",
            "TAX",
            "UNIVERSE"
          ]
        }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "policy_version",
        "mode",
        "policy_binding",
        "nee121_bindings",
        "axis_cardinalities",
        "axis_values",
        "cost_report_cardinality",
        "cost_scenario_ids",
        "cost_selection_role",
        "family_size_m",
        "effective_trials",
        "predecessor"
      ],
      "properties": {
        "schema_version": {"const": "qme.experiment_registry_runtime_policy.v1"},
        "policy_id": {"$ref": "#/$defs/text"},
        "policy_version": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["PRODUCTION_UNRESOLVED", "SYNTHETIC_TEST_ONLY"]},
        "policy_binding": {"$ref": "#/$defs/binding"},
        "nee121_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access_event_schema", "sample_holdout_manifest"],
          "properties": {
            "access_event_schema": {"$ref": "#/$defs/binding"},
            "sample_holdout_manifest": {"$ref": "#/$defs/binding"}
          }
        },
        "axis_cardinalities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filter", "holding_period", "lookback", "rebalance"],
          "properties": {
            "filter": {"const": 4},
            "holding_period": {"const": 3},
            "lookback": {"const": 4},
            "rebalance": {"const": 2}
          }
        },
        "axis_values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filter", "holding_period", "lookback", "rebalance"],
          "properties": {
            "filter": {"$ref": "#/$defs/stringArrayOrNull"},
            "holding_period": {"$ref": "#/$defs/stringArrayOrNull"},
            "lookback": {"$ref": "#/$defs/stringArrayOrNull"},
            "rebalance": {"$ref": "#/$defs/stringArrayOrNull"}
          }
        },
        "cost_report_cardinality": {"const": 3},
        "cost_scenario_ids": {"$ref": "#/$defs/stringArrayOrNull"},
        "cost_selection_role": {
          "enum": ["REPORTING_ONLY", "SELECTION_ELIGIBLE", "UNREGISTERED_BLOCKER"]
        },
        "family_size_m": {
          "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "effective_trials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["independence_assumed", "model_binding", "n_eff", "status"],
          "properties": {
            "independence_assumed": {"const": false},
            "model_binding": {"type": "null"},
            "n_eff": {"type": "null"},
            "status": {"const": "UNREGISTERED_BLOCKER"}
          }
        },
        "predecessor": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["policy_id", "head_hash", "state_sha256"],
              "properties": {
                "policy_id": {"$ref": "#/$defs/text"},
                "head_hash": {"$ref": "#/$defs/sha256"},
                "state_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        }
      }
    },
    "stringArrayOrNull": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/text"},
          "uniqueItems": true
        }
      ]
    },
    "trialRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "hypothesis_id",
        "owner_id",
        "parent_trial_id",
        "policy_id",
        "policy_version",
        "configuration_class",
        "structural_configuration_id",
        "cost_scenario_ids",
        "selection_cost_scenario_id",
        "cost_selection_role",
        "planned_outcomes",
        "repository",
        "sample_windows",
        "dimension_registration",
        "artifact_bindings"
      ],
      "properties": {
        "family_id": {"$ref": "#/$defs/text"},
        "hypothesis_id": {"$ref": "#/$defs/text"},
        "owner_id": {"$ref": "#/$defs/text"},
        "parent_trial_id": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "policy_id": {"$ref": "#/$defs/text"},
        "policy_version": {"type": "integer", "minimum": 1},
        "configuration_class": {"enum": ["REGISTERED_GRID", "OFF_GRID_MANUAL"]},
        "structural_configuration_id": {"$ref": "#/$defs/text"},
        "cost_scenario_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "selection_cost_scenario_id": {
          "oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]
        },
        "cost_selection_role": {
          "enum": ["REPORTING_ONLY", "SELECTION_ELIGIBLE", "UNREGISTERED_BLOCKER"]
        },
        "planned_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/plannedOutcome"}
        },
        "repository": {"$ref": "#/$defs/repositoryIdentity"},
        "sample_windows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sampleWindow"}
        },
        "dimension_registration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_overlay_id",
            "benchmark_id",
            "cost_id",
            "filter_id",
            "holding_period_id",
            "lookback_id",
            "rebalance_id",
            "signal_id",
            "tax_id",
            "universe_id"
          ],
          "properties": {
            "agent_overlay_id": {"$ref": "#/$defs/text"},
            "benchmark_id": {"$ref": "#/$defs/text"},
            "cost_id": {"$ref": "#/$defs/text"},
            "filter_id": {"$ref": "#/$defs/text"},
            "holding_period_id": {"$ref": "#/$defs/text"},
            "lookback_id": {"$ref": "#/$defs/text"},
            "rebalance_id": {"$ref": "#/$defs/text"},
            "signal_id": {"$ref": "#/$defs/text"},
            "tax_id": {"$ref": "#/$defs/text"},
            "universe_id": {"$ref": "#/$defs/text"}
          }
        },
        "artifact_bindings": {
          "type": "array",
          "minItems": 14,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactBinding"}
        }
      }
    },
    "sampleWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "classification",
        "start",
        "end",
        "access_mode",
        "analysis_as_of",
        "data_vintage_at",
        "data_vintage_sha256"
      ],
      "properties": {
        "window_id": {"$ref": "#/$defs/text"},
        "classification": {"$ref": "#/$defs/text"},
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "access_mode": {"$ref": "#/$defs/text"},
        "analysis_as_of": {"type": "string", "format": "date-time"},
        "data_vintage_at": {"type": "string", "format": "date-time"},
        "data_vintage_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sampleAccessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_contract_binding",
        "access_event_chain",
        "sample_access_log_head_hash",
        "trial_registration_event_hash"
      ],
      "properties": {
        "access_contract_binding": {"$ref": "#/$defs/binding"},
        "access_event_chain": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "sample-access-event-v1.schema.json"}
        },
        "sample_access_log_head_hash": {"$ref": "#/$defs/sha256"},
        "trial_registration_event_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_success_event_hashes",
        "plan_id",
        "outcome_binding",
        "validation_report",
        "validation_report_binding"
      ],
      "properties": {
        "access_success_event_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "plan_id": {"$ref": "#/$defs/text"},
        "outcome_binding": {"$ref": "#/$defs/binding"},
        "validation_report": {"type": "object"},
        "validation_report_binding": {"$ref": "#/$defs/binding"}
      }
    },
    "plannedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "outcome_artifact_id",
        "validation_report_schema_id",
        "metric_id",
        "required_sample_window_ids",
        "benchmark_id",
        "cost_scenario_id",
        "direction",
        "selection_role"
      ],
      "properties": {
        "plan_id": {"$ref": "#/$defs/text"},
        "outcome_artifact_id": {"$ref": "#/$defs/text"},
        "validation_report_schema_id": {"$ref": "#/$defs/text"},
        "metric_id": {"$ref": "#/$defs/text"},
        "required_sample_window_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "benchmark_id": {"$ref": "#/$defs/text"},
        "cost_scenario_id": {"$ref": "#/$defs/text"},
        "direction": {"enum": ["HIGHER_IS_BETTER", "LOWER_IS_BETTER"]},
        "selection_role": {
          "enum": ["PRIMARY_SELECTION", "REPORTING_ONLY", "UNREGISTERED_BLOCKER"]
        }
      }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "commit_sha",
        "tree_sha",
        "dirty_worktree",
        "dirty_patch_binding",
        "untracked_manifest_binding"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/text"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty_worktree": {"type": "boolean"},
        "dirty_patch_binding": {
          "oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]
        },
        "untracked_manifest_binding": {
          "oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"dirty_worktree": {"const": true}}},
          "then": {
            "properties": {
              "dirty_patch_binding": {"$ref": "#/$defs/binding"},
              "untracked_manifest_binding": {"$ref": "#/$defs/binding"}
            }
          },
          "else": {
            "properties": {
              "dirty_patch_binding": {"type": "null"},
              "untracked_manifest_binding": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
