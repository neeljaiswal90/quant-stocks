{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qme.local/schemas/governance/sample-access-event-v1.schema.json",
  "title": "QME append-only sample access event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "governance_contract_id", "event_id", "sequence",
    "previous_event_hash", "accessed_at", "actor_id", "purpose", "event_type",
    "trial_id", "run_id", "query_id", "analysis_as_of", "data_vintage_at",
    "data_vintage_sha256", "request_content_sha256", "parent_event_hash",
    "contract_version", "sample_classification", "requested_start", "requested_end",
    "access_mode", "artifact_bindings", "event_hash"
  ],
  "properties": {
    "schema_version": {"const": "qme.sample_access_event.v1"},
    "governance_contract_id": {"const": "NEE-121-SAMPLE-HOLDOUT-GOVERNANCE-V1"},
    "event_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_hash": {"$ref": "#/$defs/hash"},
    "accessed_at": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["ACCESS_ATTEMPT", "ACCESS_SUCCESS", "ACCESS_DENIAL", "ACCESS_RETRY"]},
    "trial_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "query_id": {"type": "string", "minLength": 1},
    "analysis_as_of": {"type": "string", "format": "date-time"},
    "data_vintage_at": {"type": "string", "format": "date-time"},
    "data_vintage_sha256": {"$ref": "#/$defs/hash"},
    "request_content_sha256": {"$ref": "#/$defs/hash"},
    "parent_event_hash": {"$ref": "#/$defs/hash"},
    "contract_version": {"type": "string", "minLength": 1},
    "sample_classification": {
      "enum": [
        "DEVELOPMENT_2011_2018",
        "ONE_TIME_HISTORICAL_CONFIRMATION_2019_2021",
        "RETROSPECTIVE_EXTERNAL_STRESS_2022_PLUS",
        "PROSPECTIVE_AFTER_FREEZE"
      ]
    },
    "requested_start": {"type": "string", "format": "date"},
    "requested_end": {"type": "string", "format": "date"},
    "access_mode": {"enum": ["READ", "MATERIALIZE", "EXPORT"]},
    "artifact_bindings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "artifact_sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "event_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
