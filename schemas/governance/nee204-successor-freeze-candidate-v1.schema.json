    "schema_version": {"const": "qme.nee204_successor_freeze_candidate.v1"},
    "candidate_id": {"const": "NEE-204-SELECTION-009-SUCCESSOR-FREEZE-CANDIDATE-V1"},
    "candidate_kind": {"const": "BLOCKER_TRANSITION_CANDIDATE_NOT_BLOCKER_CLEARANCE"},
