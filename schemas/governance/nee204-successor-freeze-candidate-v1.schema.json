    "semantic_sha256": {"$ref": "#/$defs/grouped_sha256"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_owner",
        "candidate_date",
        "protected_main",
        "independent_review_receipt",
        "owner_selection_009_decision_receipt",
        "owner_selection_009_decision_meaning",
        "empirical_results_used"
