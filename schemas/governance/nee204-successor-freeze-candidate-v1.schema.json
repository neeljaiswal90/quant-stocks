{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qme.local/schemas/governance/nee204-successor-freeze-candidate-v1.schema.json",
  "title": "NEE-204 selection-009 successor-freeze candidate v1",
  "description": "Fail-closed candidate contract. It proposes, but cannot perform, a two-row Freeze V5 blocker transition.",
