    "schema_version",
    "candidate_id",
    "candidate_kind",
    "status",
    "semantic_sha256",
    "authority",
    "candidate_incapability",
    "lineage_manifests",
    "selection_009",
    "current_freeze",
    "target",
    "proposed_transition",
    "issue_state_boundary",
    "required_next_gates",
    "claims",
    "nonclaims"
