        "paired_missing_observation_policy",
        "minimum_economic_effect_delta_econ",
        "economic_effect_decision_rule",
        "noninferiority_margin_delta_ni"
      ],
      "properties": {
        "metric_id": { "$ref": "#/$defs/unresolvedMandateField" },
        "direction": { "$ref": "#/$defs/unresolvedMandateField" },
        "benchmark_id": { "$ref": "#/$defs/unresolvedMandateField" },
        "benchmark_implementation": { "$ref": "#/$defs/unresolvedMandateField" },
