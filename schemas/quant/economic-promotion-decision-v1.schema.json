  "$defs": {
    "unresolvedMandateField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "units",
        "mandate_source",
        "approval_owner",
        "approved_at",
        "effective_version",
        "sensitivity_range"
      ],
      "properties": {
        "status": { "const": "UNRESOLVED_BLOCKER" },
        "value": { "type": "null" },
        "units": { "type": "null" },
        "mandate_source": { "type": ["string", "null"] },
        "approval_owner": { "type": "null" },
        "approved_at": { "type": "null" },
        "effective_version": { "type": "null" },
        "sensitivity_range": { "type": "null" }
      }
    }
