        "selection_rule_and_family_size_m": { "$ref": "#/$defs/unresolvedMandateField" },
        "cost_and_tax_scenario": { "$ref": "#/$defs/unresolvedMandateField" },
        "prospective_observation_length_or_information_requirement": {
          "$ref": "#/$defs/unresolvedMandateField"
        },
        "missing_data_policy": { "const": "FAIL_CLOSED_NO_GO" }
      }
    },
    "decision_math": {
      "const": {
        "raw_delta": "strategy_metric - benchmark_metric",
        "higher_is_better_oriented_delta": "strategy_metric - benchmark_metric",
        "higher_is_better_oriented_bound": "raw_delta_lower_bound",
        "lower_is_better_oriented_delta": "benchmark_metric - strategy_metric",
        "lower_is_better_oriented_bound": "-raw_delta_upper_bound",
        "noninferiority_rule": "oriented_confidence_bound > -delta_ni",
        "exact_boundary_action": "NO_GO",
        "missing_or_failed_criterion_action": "NO_GO",
        "promotion_claim_scope": "PROSPECTIVE_EVIDENCE_ONLY_NO_LIVE_ORDER_AUTHORITY"
      }
    },
