          "$ref": "#/$defs/unresolvedMandateField"
        },
        "prospective_evidence_clock_resume_or_restart_rule": {
          "$ref": "#/$defs/unresolvedMandateField"
        },
        "missing_rule_or_observation_action": { "const": "FAIL_SAFE_ABORT" },
        "aborted_state_persistence": {
          "const": "STICKY_UNTIL_MATCHING_EXPLICIT_RESTART_APPROVAL"
        }
      }
