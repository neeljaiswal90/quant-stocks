      "type": "object",
      "additionalProperties": false,
      "required": [
        "abort_metric_id",
        "abort_threshold",
        "abort_orientation_and_operator",
        "abort_lookback",
        "abort_persistence",
        "abort_owner",
        "restart_authority",
        "verified_checkpoint_and_input_hash_policy",
        "prospective_evidence_clock_resume_or_restart_rule",
        "missing_rule_or_observation_action",
        "aborted_state_persistence"
