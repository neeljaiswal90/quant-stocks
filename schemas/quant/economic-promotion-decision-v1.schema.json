      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_level",
        "alpha",
        "dependence_aware_interval_method",
        "block_length_or_selection_rule",
        "resampling_seed",
        "resampling_replicate_count",
        "comparison_family_and_multiplicity_rule",
        "selection_rule_and_family_size_m",
        "cost_and_tax_scenario",
        "prospective_observation_length_or_information_requirement",
        "missing_data_policy"
