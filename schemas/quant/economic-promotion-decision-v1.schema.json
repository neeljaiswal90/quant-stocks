      "properties": {
        "confidence_level": { "$ref": "#/$defs/unresolvedMandateField" },
        "alpha": { "$ref": "#/$defs/unresolvedMandateField" },
        "dependence_aware_interval_method": { "$ref": "#/$defs/unresolvedMandateField" },
        "block_length_or_selection_rule": { "$ref": "#/$defs/unresolvedMandateField" },
